{
  "name": "rxjs-fullstack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run --hot src/server/bun.ts",
    "start": "bun run src/server/bun.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run scripts/verify.tsx",
    "build:client": "bun build src/examples/counter-client.tsx --outdir dist/client --target browser",
    "build:todos": "bun build src/examples/todos-client.tsx --outdir dist/client --target browser",
    "check": "bun run typecheck && bun run verify && bun run build:client && bun run build:todos"
  },
  "dependencies": {
    "@netxpert/rxjs-query": "file:../rxjs-query/packages/core/netxpert-rxjs-query-0.1.0.tgz",
    "hono": "4.13.3",
    "rxjs": "7.8.2",
    "rxjs-router": "file:../rxjs-router"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
